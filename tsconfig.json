{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module

    // "module": "nodenext", node use korle eta 
    "module": "esnext", // browsere use korle es
    "target": "esnext",
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    



    // Recommended Options
    "strict": true,
    "skipLibCheck": true,
  }
}
